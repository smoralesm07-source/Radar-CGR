  },
  "temporal_evidence": {
    "time_fields": ["valid_from","valid_to","source_published_at","observed_at","retrieved_at","ingested_at","last_seen_at"],
    "evidence_fields": ["evidence_id","producer_id","source_id","source_url","ultimate_source_id","source_tier","capture_method","source_run_id","content_sha256","quality_status","schema_version"],
    "freshness_states": ["CURRENT","DUE","STALE","UNKNOWN"],
    "source_failure_is_zero": false,
    "preserve_last_known_good": true,
    "current_status": "FUSION_EXPORT_READY",
    "builder": "radar_cgr/fusion_export.py"
  },
  "relationships": {
    "current_status": "FUSION_EXPORT_READY_WITH_GUARDRAIL",
    "materialized_path": "data/silver/relationships_fusion_v1.jsonl",
    "promotion_policy": "BOTH_ENDPOINTS_CANONICALLY_RESOLVED_AND_EVIDENCE_PRESENT",
    "assertion_type": "DERIVED"
