  "exports": [
    {"path":"data/silver/entities_fusion_v1.jsonl","purpose":"Fusion Layer Entity objects"},
    {"path":"data/silver/events_fusion_v1.jsonl","purpose":"Fusion Layer Event objects"},
    {"path":"data/silver/relationships_fusion_v1.jsonl","purpose":"Fusion Layer Relationship objects with canonical endpoints"},
    {"path":"data/silver/evidence_fusion_v1.jsonl","purpose":"Fusion Layer Evidence objects"},
    {"path":"docs/data/fusion_interop_status_v1.json","purpose":"materialization and candidate status"}
  ],
  "consumer_contract": {
    "manifest_path": "interop/integration_manifest_v1.json",
    "schema_path": "interop/interop_contract_v1.schema.json",
    "canonical_consumer": "smoralesm07-source/Intelligence_Fusion_Layer"
  }
